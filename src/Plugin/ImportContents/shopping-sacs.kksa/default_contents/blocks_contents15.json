tion_location"}],"status":[{"value":"1"}],"created":[{"value":"1724324438"}],"parent_id":[{"value":"15"}],"parent_type":[{"value":"blocks_contents"}],"parent_field_name":[{"value":"paragraph_revisions"}],"behavior_settings":[{"value":"a:0:{}"}],"default_langcode":[{"value":"1"}],"revision_default":[{"value":"1"}],"revision_translation_affected":[{"value":"1"}],"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Select Export Entity | Drush Site-Install"}},{"tag":"link","attributes":{"rel":"canonical","href":"http:\/\/shopping-sacs.kksa\/fr\/admin\/export-import-entities\/select-export-storage-entity"}}],"field_description":[{"value":"\u003Ch3\u003EArticle 1 : Objet\u003C\/h3\u003E\n\u003Cp\u003ELes pr\u00e9sentes Conditions G\u00e9n\u00e9rales de Vente (CGV) d\u00e9terminent les droits et obligations des parties dans le cadre de la vente en ligne de Produits ou Services propos\u00e9s par notre soci\u00e9t\u00e9.\n\u003C\/p\u003E\n\n\u003Ch3\u003EArticle 2 : Identification du vendeur\u003C\/h3\u003E\n\n\u003Cp\u003ENom de la soci\u00e9t\u00e9 : [Nom de votre soci\u00e9t\u00e9]\u003Cbr \/\u003E\n\t\u003Cbr \/\u003E\n\tAdresse : [Adresse de votre soci\u00e9t\u00e9]\u003Cbr \/\u003E\n\t\u003Cbr \/\u003E\n\tNum\u00e9ro de t\u00e9l\u00e9phone : [Num\u00e9ro de t\u00e9l\u00e9phone]\u003Cbr \/\u003E\n\t\u003Cbr \/\u003E\n\tEmail : [Adresse email]\u003Cbr \/\u003E\n\t\u003Cbr \/\u003E\n\tNum\u00e9ro SIRET : [Num\u00e9ro SIRET]\u003Cbr \/\u003E\n\t\u003Cbr \/\u003E\n\tRepr\u00e9sentant l\u00e9gal : [Nom du repr\u00e9sentant l\u00e9gal]\n\u003C\/p\u003E\n\n\u003Ch3\u003EArticle 3 : Produits\u003C\/h3\u003E\n\n\u003Cp\u003ELes caract\u00e9ristiques essentielles des produits et services sont pr\u00e9sent\u00e9es sur notre site internet. Le client est tenu d\u0027en prendre connaissance avant toute passation de commande. Les photographies ou graphismes pr\u00e9sent\u00e9s n\u0027ont pas de valeur contractuelle.\n\u003C\/p\u003E\n\n\u003Ch3\u003EArticle 4 : Prix\u003C\/h3\u003E\n\n\u003Cp\u003ELes prix des produits sont indiqu\u00e9s en euros, toutes taxes comprises (TTC). Les frais de livraison ne sont pas inclus dans le prix affich\u00e9 et seront ajout\u00e9s au montant total de la commande.\n\u003C\/p\u003E\n\n\u003Ch3\u003EArticle 5 : Commande\u003C\/h3\u003E\n\n\u003Cp\u003ELe client passe commande sur notre site internet. Pour acheter un produit, il doit suivre le processus de commande en ligne et cliquer sur \u0022Valider la commande\u0022 pour soumettre la commande.\n\u003C\/p\u003E\n\n\u003Ch3\u003EArticle 6 : Paiement\u003C\/h3\u003E\n\n\u003Cp\u003ELe paiement est exigible imm\u00e9diatement \u00e0 la commande. Le client peut r\u00e9gler par carte bancaire, Paypal, ch\u00e8que ou virement bancaire. Les transactions sont s\u00e9curis\u00e9es par un prestataire de paiement en ligne.\n\u003C\/p\u003E\n\n\u003Ch3\u003EArticle 7 : Livraison\u003C\/h3\u003E\n\n\u003Cp\u003ELes produits sont livr\u00e9s \u00e0 l\u0027adresse de livraison indiqu\u00e9e par le client lors de la commande. Les d\u00e9lais de livraison sont donn\u00e9s \u00e0 titre indicatif et peuvent varier en fonction de la disponibilit\u00e9 des produits et du transporteur.\n\u003C\/p\u003E\n\n\u003Ch3\u003EArticle 8 : R\u00e9tractation\u003C\/h3\u003E\n\n\u003Cp\u003EConform\u00e9ment \u00e0 la loi, le client dispose d\u0027un d\u00e9lai de 14 jours \u00e0 compter de la r\u00e9ception des produits pour exercer son droit de r\u00e9tractation sans avoir \u00e0 justifier de motifs ni \u00e0 payer de p\u00e9nalit\u00e9s.\n\u003C\/p\u003E\n\n\u003Ch3\u003EArticle 9 : Garantie\u003C\/h3\u003E\n\n\u003Cp\u003ENos produits b\u00e9n\u00e9ficient de la garantie l\u00e9gale de conformit\u00e9 et de la garantie contre les vices cach\u00e9s, conform\u00e9ment aux dispositions l\u00e9gales en vigueur.\n\u003C\/p\u003E\n\n\u003Ch3\u003EArticle 10 : Responsabilit\u00e9\u003C\/h3\u003E\n\n\u003Cp\u003ELa soci\u00e9t\u00e9 ne saurait \u00eatre tenue pour responsable des dommages r\u00e9sultant d\u0027une mauvaise utilisation du produit achet\u00e9. La responsabilit\u00e9 de la soci\u00e9t\u00e9 sera, en tout \u00e9tat de cause, limit\u00e9e au montant de la commande.\n\u003C\/p\u003E\n\n\u003Ch3\u003EArticle 11 : Donn\u00e9es personnelles\u003C\/h3\u003E\n\n\u003Cp\u003ELes informations recueillies sur le client font l\u0027objet d\u0027un traitement informatique destin\u00e9 \u00e0 la gestion de la commande et \u00e0 l\u0027am\u00e9lioration des services. Conform\u00e9ment \u00e0 la loi \u0022Informatique et Libert\u00e9s\u0022, le client dispose d\u0027un droit d\u0027acc\u00e8s, de rectification et de suppression des donn\u00e9es le concernant.\n\u003C\/p\u003E\n\n\u003Ch3\u003EArticle 12 : Litiges\u003C\/h3\u003E\n\n\u003Cp\u003ELes pr\u00e9sentes CGV sont soumises \u00e0 la loi fran\u00e7aise. En cas de litige, les parties s\u0027efforceront de trouver une solution amiable avant de recourir aux tribunaux comp\u00e9tents.\n\u003C\/p\u003E\n","format":"full_html"}],"field_subtitle":[],"field_title":[{"value":"Conditions G\u00e9n\u00e9rales de Vente (CGV)"}],"layout_builder__layout":[{"section":{"layout_id":"formatage_models_simple_block","layout_settings":{"css":"space-inner-py","region_tag_main":"h1","config_section":{"type_container":"with-tablet","container_class":"mx-auto","id":"formatage-models-simple-block-7318--rhkjfBSObk8"},"sf":{"builder-form":true,"info":{"title":" Contenu ","loader":"dynamic"},"fields":{"main":{"text_html":{"label":"Description","value":"","format":"full_html"}},"teasers_container":{"text_html":{"label":"Container pour Teaser","value":"","format":"full_html"}},"image_bg":{"img_bg":{"label":"image","fids":[],"style":"","class":"","inbg":0}}}},"region_css_main":"h1 text-black  space-inner-bottom","region_css_block_2":" h6 text-align-left small text-black","region_css_block_3":"h6 small","region_css_block_4":"","region_css_block_5":"","region_css_block_6":"","region_css_image_bg":"","region_css_teasers_conta